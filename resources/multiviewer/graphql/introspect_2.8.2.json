"""Clock information for the live timing"""
type LiveTimingClock {
    """Whether or not the clock is paused"""
  paused: Boolean!

  """The timestamp on the host computer that represents the `trackTime`"""
  systemTime: BigInt!

  """The timestamp at the track, at the time on the host computer"""
  trackTime: BigInt!

  """
  Live timing start time, indicating the first recorded event's timestamp (track time)
  """
  liveTimingStartTime: BigInt!
}

"""Clock information for the live timing"""
type F1LiveTimingClock {
    """Whether or not the clock is paused"""
  paused: Boolean!

  """The timestamp on the host computer that represents the `trackTime`"""
  systemTime: BigInt!

  """The timestamp at the track, at the time on the host computer"""
  trackTime: BigInt!

  """
  Live timing start time, indicating the first recorded event's timestamp (track time)
  """
  liveTimingStartTime: BigInt!
}

"""FIA WEC live timing state"""
type FIAWECLiveTimingState {
    """Car positions"""
  positions: JSONObject

  """Session data"""
  session: JSONObject

  """Race control messages"""
  raceControl: JSONObject
}

"""A subscription"""
type Subscription {
    """The type of subscription"""
  subscriptionType: SubscriptionType!

  """The date the subscription expires (in seconds since the epoch)"""
  expiresAt: Int

  """
  A JWT token that can be used to verify the subscription
  
  ### To verify:
  
  1. Retrieve the public key from https: //multiviewer.app/.well-known/subscription-verification-public-key.pub
  2. Verify the signature using the public key
  
  ### Example (Node.js)
  
  ```ts
  import { verify
    } from "jsonwebtoken";
  
  // The public key can be retrieved from https://multiviewer.app/.well-known/subscription-verification-public-key.pub
  const publicKey = "---BEGIN PUBLIC KEY---\n...\n---END PUBLIC KEY---";
  
  const verified = verify(token, publicKey,
    {
    algorithms: [
            "RS256"
        ],
    issuer: "multiviewer.app",
    });
  ```
  """
  signature: String!
}

"""The type of subscription"""
enum SubscriptionType {
  F1TV_PREMIUM
  F1TV_PRO
  F1TV_ACCESS
  F1_ACCESS
}